# Bound PPT local configuration. Copy to .env and fill secrets locally.
# Never commit real secrets.

APP_ENV=development
APP_BASE_URL=http://127.0.0.1:5173
SESSION_SECRET=dev-only-session-secret-change-me
AUTO_CREATE_TABLES=true

# SQLite is the zero-setup local default. Production MUST use PostgreSQL.
DATABASE_URL=sqlite+aiosqlite:///./backend/bound_ppt.db
# DATABASE_URL=postgresql+asyncpg://bound:bound@127.0.0.1:5432/bound_ppt
DIRECT_DATABASE_URL=

# Storage: local (default) or s3
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./backend/storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Model provider: stub (development only) or openai-compatible
MODEL_PROVIDER=stub
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=
MODEL_ID=gpt-4o-mini
MODEL_ECONOMY_ID=
MODEL_QUALITY_ID=

# Search provider: stub (development only) or tavily
SEARCH_PROVIDER=stub
SEARCH_API_KEY=
SEARCH_CAP_PER_PROJECT=12

# Pilot identity seeded on startup in development; replace in production.
PILOT_EMAIL=pilot@boundppt.local
PILOT_PASSWORD=boundppt-demo
PILOT_NAME=Pilot User

# Limits (configuration, not product constants)
MATERIAL_MAX_COUNT=6
PAGE_MAX_COUNT=30
UPLOAD_MAX_BYTES=20971520
INGEST_MAX_CHARS=120000

PAGE_HISTORY_MAX_DEPTH=20
JOB_MAX_ATTEMPTS=3
GENERATION_WORKERS=4
INGESTION_WORKERS=2
EXPORT_WORKERS=1
