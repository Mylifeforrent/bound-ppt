{
  "styleKey": "editorial-indigo",
  "name": "Editorial Indigo",
  "version": 1,
  "scope": "BUILTIN",
  "description": "Confident editorial pages with indigo accents, generous whitespace, and a consulting-report tone.",
  "useCase": "Strategy reviews, product launches, board narratives.",
  "licenseStatus": "CLEARED",
  "palette": {
    "primary": "#4f46e5",
    "secondary": "#312e81",
    "accent": "#b45309",
    "background": "#ffffff",
    "surface": "#eef0ff",
    "text": "#161c2d",
    "muted": "#566079"
  },
  "fonts": { "display": "Inter", "body": "Inter" },
  "textStyles": {
    "headline": { "size": 46, "weight": 700, "colorRole": "text", "lineHeight": 1.12 },
    "subhead": { "size": 28, "weight": 600, "colorRole": "primary", "lineHeight": 1.2 },
    "body": { "size": 19, "weight": 400, "colorRole": "text", "lineHeight": 1.5 },
    "bullet_list": { "size": 19, "weight": 400, "colorRole": "text", "lineHeight": 1.5 },
    "metric": { "size": 54, "weight": 700, "colorRole": "primary", "lineHeight": 1 },
    "quote": { "size": 24, "weight": 500, "colorRole": "secondary", "lineHeight": 1.4 },
    "callout": { "size": 18, "weight": 500, "colorRole": "text", "lineHeight": 1.4 },
    "footer": { "size": 13, "weight": 500, "colorRole": "muted", "lineHeight": 1.2 }
  },
  "tokens": {
    "radius": 18,
    "surfaceAlpha": 1,
    "accentBar": 6,
    "cardBorder": true,
    "headingRule": true
  }
}
