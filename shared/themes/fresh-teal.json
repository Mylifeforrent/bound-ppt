{
  "styleKey": "fresh-teal",
  "name": "Fresh Teal",
  "version": 1,
  "scope": "BUILTIN",
  "description": "Fresh teal and off-white pages with rounded cards, suited to product and marketing storytelling.",
  "useCase": "Marketing campaigns, training decks, partner updates.",
  "licenseStatus": "CLEARED",
  "palette": {
    "primary": "#0f766e",
    "secondary": "#115e59",
    "accent": "#ea580c",
    "background": "#fbfffe",
    "surface": "#ccfbf1",
    "text": "#102a27",
    "muted": "#4f6b67"
  },
  "fonts": { "display": "Inter", "body": "Inter" },
  "textStyles": {
    "headline": { "size": 46, "weight": 700, "colorRole": "text", "lineHeight": 1.13 },
    "subhead": { "size": 27, "weight": 600, "colorRole": "primary", "lineHeight": 1.22 },
    "body": { "size": 19, "weight": 400, "colorRole": "text", "lineHeight": 1.5 },
    "bullet_list": { "size": 19, "weight": 400, "colorRole": "text", "lineHeight": 1.5 },
    "metric": { "size": 52, "weight": 700, "colorRole": "primary", "lineHeight": 1 },
    "quote": { "size": 24, "weight": 500, "colorRole": "secondary", "lineHeight": 1.4 },
    "callout": { "size": 18, "weight": 500, "colorRole": "text", "lineHeight": 1.4 },
    "footer": { "size": 13, "weight": 500, "colorRole": "muted", "lineHeight": 1.2 }
  },
  "tokens": {
    "radius": 26,
    "surfaceAlpha": 1,
    "accentBar": 10,
    "cardBorder": false,
    "headingRule": false
